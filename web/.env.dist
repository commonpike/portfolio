# Template for web/.env — copy it and edit:
#
#   cp .env.dist .env
#
# .env is git-ignored; this file is the tracked record of what needs setting.
# These settings are baked into the bundle at build time, so a change needs a
# rebuild. .env.local overrides .env if you want a machine-local variant.

# Where the site is hosted: "/" at the root of a domain, "/portfolio/" when it
# lives in a subdirectory. The build writes every URL of its own against this —
# the scripts in index.html, the favicon — and the router takes it as its base, so
# this one line places the whole site. It is the one setting src/config.ts does
# not read: vite.config.ts consumes it and hands it back as BASE_URL.
#
# Leading and trailing slash both, and it also moves `npm run dev`: with
# "/portfolio/" the dev server serves the site at localhost:5173/portfolio/.
VITE_BASE_URL=/

# The URL of the JSON exporter, php/json.php. The defaults below assume a PHP
# server started in the repository root:
#
#   php -S localhost:8000
#
# The browser reads this cross-origin while `npm run dev` serves the site from
# another port; the exporter sends Access-Control-Allow-Origin: * so that works.
VITE_PORTFOLIO_JSON_URL=http://localhost:8000/php/json.php

# PrimeVue's license key — PrimeVue 5 is licensed software, free for individuals
# under its Community License. Deliberately left empty here: the key belongs in
# .env, which git ignores. Without it the library only logs a notice.
VITE_PRIMEVUE_LICENSE_KEY=

# The base URL the relative paths inside that JSON (images, files, preview) are
# served from. The exporter returns them relative to the asset root, e.g.
# "2012/wereldkiezer/preview.jpg", and the asset root is not normally reachable
# from the web, so this points at wherever those files are actually hosted.
VITE_ASSET_BASE_URL=http://localhost:8000/projects
